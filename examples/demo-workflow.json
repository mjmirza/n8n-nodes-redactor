{
  "name": "PII Redactor Demo: Redact and Restore",
  "meta": {
    "instanceId": "redactor-demo"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Start Here",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"ticket_id\": \"TICKET-4821\",\n  \"customer\": {\n    \"name\": \"Mrs. Sarah Johnson\",\n    \"email\": \"sarah.johnson@bigcorp.com\",\n    \"phone\": \"+49 30 1234-5678\",\n    \"ssn\": \"987-65-4321\",\n    \"iban\": \"DE89370400440532013000\"\n  },\n  \"message\": \"Dear Support, I am Mrs. Sarah Johnson (sarah.johnson@bigcorp.com). My SSN is 987-65-4321 and my IBAN is DE89370400440532013000. I was charged twice for order ORD-992841. Please refund to my account. My address is Musterstra\u00dfe 12, 80331 M\u00fcnchen. Best regards, Mrs. Sarah Johnson\",\n  \"internal_notes\": \"Customer called from +49 30 1234-5678. Verified identity via SSN 987-65-4321. Server log: 192.168.1.42:8080\"\n}",
        "options": {}
      },
      "id": "set-1",
      "name": "Sample Customer Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "operation": "redact",
        "sessionId": "={{ $execution.id }}",
        "redactionMode": "token",
        "piiTypes": [
          "email",
          "phone",
          "phoneDE",
          "personName",
          "ssn",
          "iban",
          "ipv4",
          "privateIp",
          "ipv4Port",
          "addressDE"
        ],
        "dedup": true,
        "fieldMode": "all",
        "vaultStorage": "memory",
        "sessionTtl": 60,
        "includeReport": false
      },
      "id": "redact-1",
      "name": "Redact PII",
      "type": "n8n-nodes-redactor.redactor",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "restore",
        "sessionId": "={{ $execution.id }}",
        "vaultStorage": "memory",
        "deleteAfterRestore": true
      },
      "id": "restore-1",
      "name": "Restore PII",
      "type": "n8n-nodes-redactor.redactor",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    }
  ],
  "connections": {
    "Start Here": {
      "main": [
        [
          {
            "node": "Sample Customer Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sample Customer Data": {
      "main": [
        [
          {
            "node": "Redact PII",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Redact PII": {
      "main": [
        [
          {
            "node": "Restore PII",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
