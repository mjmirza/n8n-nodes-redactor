{
  "name": "n8n-nodes-redactor",
  "version": "6.0.0",
  "description": "Redact, mask and anonymize PII before it reaches an LLM, then restore it. 216 patterns for emails, phones, addresses, IBAN, cards, names, SSN, passport and tax IDs. Reversible encrypted vault, GDPR Art.30 ROPA record, prompt-injection check. Runs on n8n Cloud and self-hosted n8n 2.x.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "redactor",
    "redact",
    "pii",
    "remove-data",
    "remove-pii",
    "data-masking",
    "data-privacy",
    "data-protection",
    "anonymize",
    "anonymization",
    "sanitize",
    "scrub",
    "mask",
    "gdpr",
    "hipaa",
    "ccpa",
    "dsgvo",
    "compliance",
    "privacy",
    "personal-data",
    "sensitive-data",
    "iban",
    "credit-card",
    "ssn",
    "email",
    "phone",
    "address",
    "passport",
    "tax-id",
    "eu",
    "dach",
    "european",
    "llm",
    "openai",
    "claude",
    "ai",
    "next8n",
    "workflow",
    "automation"
  ],
  "author": {
    "name": "Mirza Iqbal",
    "email": "support@next8n.com",
    "url": "https://next8n.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/mjmirza/n8n-nodes-redactor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjmirza/n8n-nodes-redactor.git"
  },
  "bugs": {
    "url": "https://github.com/mjmirza/n8n-nodes-redactor/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "eslint package.json nodes credentials",
    "lint:fix": "eslint package.json nodes credentials --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "hooks": "git config core.hooksPath .husky"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/RedactorVaultApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Redactor/Redactor.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.38.1",
    "@n8n/node-cli": "^0.54.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.29.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^2.45.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
